{
  "name": "quiet-la-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-local-next.mjs dev",
    "build": "node scripts/refuse-unprofiled-build.mjs",
    "build:local": "node scripts/stage-local-data.mjs && node scripts/build-local-profile.mjs",
    "build:external": "node scripts/build-external-payload-free.mjs",
    "build:vercel-profile": "node scripts/build-vercel-profile.mjs",
    "build:private-preview": "node scripts/assert-private-preview-build-context.mjs && node scripts/stage-private-preview.mjs && node scripts/verify-private-preview-bundle.mjs && node scripts/build-clean-manifest.mjs && node scripts/build-private-preview.mjs && node scripts/verify-private-preview-export.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "stage:local": "node scripts/stage-local-data.mjs",
    "stage:private-preview": "node scripts/stage-private-preview.mjs",
    "verify:external": "node scripts/verify-external-payload-free-export.mjs",
    "verify:external-source": "node scripts/verify-external-tree.mjs",
    "verify:private-preview": "node scripts/verify-private-preview-bundle.mjs && node scripts/verify-private-preview-export.mjs",
    "verify:replacement-adapter": "node scripts/verify-replacement-layer-adapter.mjs",
    "verify:private-preview-source": "node scripts/verify-private-preview-source-tree.mjs",
    "verify:vercel-project": "node scripts/verify-vercel-project-evidence.mjs",
    "manifest:clean": "node scripts/build-clean-manifest.mjs",
    "test:contracts": "node scripts/build-clean-manifest.mjs && node --test tests/*.test.mjs",
    "test:browser": "node scripts/run-browser-engines.mjs",
    "test:browser:external": "node scripts/browser-check-external.mjs",
    "test:browser:private-preview": "node scripts/browser-check-private-preview.mjs"
    ,"test:profile-sequences": "node scripts/test-profile-build-sequences.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "next": "15.5.9",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.9",
    "typescript": "^5.7.2"
  }
}
